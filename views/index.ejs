<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>
        Terméklista
    </title>
    <link rel="stylesheet" href="/style.css">
</head>

<body>
    <ul>
        <li>
            <a href="/filter">Szűrés</a>
        </li>
        <li>
            <a href="/new">Új termék</a>
        </li>
    </ul>
    <table>
        <thead>
            <tr>
                <th>Termék neve</th>
                <th>Kategória</th>
                <th>Ár</th>
                <th>Raktárkészlet</th>
            </tr>
        </thead>
        <tbody>
            <%products.forEach((product)=>{%>
                <tr class=<%=product.stock==0 ? "low-stock" : "" %>>
                    <td>
                        <%=product.name%>
                    </td>
                    <td>
                        <%=product.category%>
                    </td>
                    <td>
                        <%=product.price%>
                    </td>
                    <td class=<%=product.stock < 5 ? "low-stock" : "" %>>
                        <%=product.stock%>
                    </td>
                </tr>
                <%})%>
        </tbody>
    </table>
</body>

</html>