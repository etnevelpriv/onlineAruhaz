<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Szűrés</title>
    <link rel="stylesheet" href="/style.css">
</head>

<body>
    <form method="get">
        <div class="input-group">
            <label for="category">Kategória</label>
            <select name="category" id="categorySelect">
                <option value="elektronika">Elektronika</option>
                <option value="ruházat">Ruházat</option>
                <option value="könyv">Könyv</option>
                <option value="játék">Játék</option>
            </select>
        </div>
        <input type="submit" value="Keresés">
    </form>
    <% if (products.length) {%>
    <table>
        <thead>
            <tr>
                <th>Termék neve</th>
                <th>Kategória</th>
                <th>Ár</th>
                <th>Raktárkészlet</th>
            </tr>
        </thead>
        <tbody>
            <%products.forEach((product)=>{%>
                <tr class=<%=product.stock==0 ? "low-stock" : "" %>>
                    <td>
                        <%=product.name%>
                    </td>
                    <td>
                        <%=product.category%>
                    </td>
                    <td>
                        <%=product.price%>
                    </td>
                    <td class=<%=product.stock < 5 ? "low-stock" : "" %>>
                        <%=product.stock%>
                    </td>
                </tr>
                <%})%>
        </tbody>
    </table>
    <%}%>
</body>

</html>